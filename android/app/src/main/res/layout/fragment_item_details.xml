<?xml version="1.0" encoding="utf-8"?>
<!-- SCR-07 — detalji predmeta i brisanje (tiket 16). BR-007: ekran prima samo itemId i sam ucitava iz Room-a. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <ProgressBar
        android:id="@+id/progressLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="@dimen/auth_screen_padding"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/containerActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imagePhoto"
                android:layout_width="match_parent"
                android:layout_height="@dimen/itemdetails_photo_height"
                android:layout_marginBottom="@dimen/auth_section_spacing"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone"
                tools:src="@drawable/ic_category_other"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/textName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                tools:text="Samsung TV 55&quot;" />

            <TextView
                android:id="@+id/textCategoryLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_field_spacing"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                tools:text="Elektronika • Dnevna soba" />

            <include
                android:id="@+id/rowDescription"
                layout="@layout/item_detail_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/additem_section_spacing" />

            <include
                android:id="@+id/rowManufacturer"
                layout="@layout/item_detail_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_field_spacing" />

            <include
                android:id="@+id/rowModel"
                layout="@layout/item_detail_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_field_spacing" />

            <include
                android:id="@+id/rowSerialNumber"
                layout="@layout/item_detail_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_field_spacing" />

            <include
                android:id="@+id/rowQuantity"
                layout="@layout/item_detail_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_field_spacing" />

            <include
                android:id="@+id/rowPurchasePrice"
                layout="@layout/item_detail_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_field_spacing" />

            <include
                android:id="@+id/rowEstimatedValue"
                layout="@layout/item_detail_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_field_spacing" />

            <!-- US-15/BR-013 — vidljivo samo kad se valuta predmeta razlikuje od valute prikaza (tiket 21). -->
            <include
                android:id="@+id/rowConvertedValue"
                layout="@layout/item_detail_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_field_spacing" />

            <include
                android:id="@+id/rowPurchaseDate"
                layout="@layout/item_detail_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_field_spacing" />

            <include
                android:id="@+id/rowWarrantyDate"
                layout="@layout/item_detail_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_field_spacing" />

            <!-- BR-010 — status garancije i preostali broj dana, uvek izvedeno (tiket 22). -->
            <include
                android:id="@+id/rowWarrantyStatus"
                layout="@layout/item_detail_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_field_spacing" />

            <include
                android:id="@+id/rowSeller"
                layout="@layout/item_detail_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_field_spacing" />

            <include
                android:id="@+id/rowNotes"
                layout="@layout/item_detail_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/auth_field_spacing" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/groupError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/auth_screen_padding"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <TextView
            android:id="@+id/textErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            tools:text="@string/error_not_found" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/containerActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/auth_field_spacing"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonEdit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/auth_field_spacing"
            android:layout_weight="1"
            android:text="@string/itemdetails_action_edit" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDelete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/itemdetails_action_delete" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
