<?xml version="1.0" encoding="utf-8"?>
<!-- SCR-09 — profil, tiket 12 pokriva samo prikaz podataka i odjavu; ostalo dolazi kasnije. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:padding="@dimen/auth_screen_padding">

    <!-- BR-017 Loading — kratak, gotovo neprimetan trenutak dok currentUser Flow prvi put ne emituje. -->
    <ProgressBar
        android:id="@+id/progressLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auth_title_spacing"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Marko Tatović"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/textEmail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auth_field_spacing"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textName"
        tools:text="marko@example.com"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/textRole"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auth_field_spacing"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textEmail"
        tools:text="Administrator"
        tools:visibility="visible" />

    <!-- US-15/BR-012 — valuta prikaza, zatvorena lista podrzanih valuta (tiket 21). -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutCurrency"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auth_section_spacing"
        android:hint="@string/profile_label_currency"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textRole"
        tools:visibility="visible">

        <AutoCompleteTextView
            android:id="@+id/editCurrency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- FR-051/FR-052 — prag za upozorenje o garanciji (tiket 22). -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutWarrantyThreshold"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auth_field_spacing"
        android:hint="@string/profile_label_warranty_threshold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutCurrency"
        tools:visibility="visible">

        <AutoCompleteTextView
            android:id="@+id/editWarrantyThreshold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Izbor teme (svetla/tamna/sistemska), primenjuje se odmah bez restarta aplikacije. -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutTheme"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auth_field_spacing"
        android:hint="@string/profile_label_theme"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutWarrantyThreshold"
        tools:visibility="visible">

        <AutoCompleteTextView
            android:id="@+id/editTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonLocations"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auth_section_spacing"
        android:text="@string/nav_locations"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutTheme"
        tools:visibility="visible" />

    <!-- FR-100 — vidljivo samo roli ADMIN (tiket 25). -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonAdmin"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auth_field_spacing"
        android:text="@string/profile_action_admin"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonLocations"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonLogout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auth_field_spacing"
        android:text="@string/profile_action_logout"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonAdmin"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
