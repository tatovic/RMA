<?xml version="1.0" encoding="utf-8"?>
<!-- Red liste inventara — SCR-04, tiket 14. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/auth_screen_padding"
    android:paddingVertical="@dimen/auth_field_spacing">

    <ImageView
        android:id="@+id/imageItem"
        android:layout_width="@dimen/inventory_item_image_size"
        android:layout_height="@dimen/inventory_item_image_size"
        android:background="?attr/colorSurfaceVariant"
        android:scaleType="centerCrop"
        tools:src="@drawable/ic_category_electronics" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/auth_field_spacing"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textItemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            tools:text="Samsung TV 55&quot;" />

        <TextView
            android:id="@+id/textItemSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            tools:text="Elektronika • Dnevna soba" />

    </LinearLayout>

    <TextView
        android:id="@+id/textItemValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/auth_field_spacing"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        tools:text="120.000,00 RSD" />

</LinearLayout>
