<?xml version="1.0" encoding="utf-8"?>
<!-- Forma za dodavanje/izmenu lokacije — SCR-10, tiket 17. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/auth_screen_padding"
    android:paddingTop="@dimen/auth_field_spacing">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutLocationName"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/locations_label_name">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editLocationName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            tools:text="Garaža" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutLocationDescription"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auth_field_spacing"
        android:hint="@string/locations_label_description">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editLocationDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
