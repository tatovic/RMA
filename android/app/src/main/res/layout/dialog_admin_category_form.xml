<?xml version="1.0" encoding="utf-8"?>
<!-- Forma za dodavanje/preimenovanje kategorije — SCR-13, tiket 25. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/auth_screen_padding"
    android:paddingTop="@dimen/auth_field_spacing">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutCategoryName"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/admin_categories_label_name">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editCategoryName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            tools:text="Elektronika" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
