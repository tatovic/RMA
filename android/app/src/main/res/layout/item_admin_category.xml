<?xml version="1.0" encoding="utf-8"?>
<!-- Red liste globalnih kategorija — SCR-13, tiket 25. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/auth_screen_padding"
    android:paddingVertical="@dimen/auth_field_spacing">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textCategoryName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            tools:text="Elektronika" />

        <TextView
            android:id="@+id/textCategoryCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            tools:text="12 predmeta" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonEditCategory"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/admin_categories_action_edit" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonDeleteCategory"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/admin_categories_action_delete" />

</LinearLayout>
