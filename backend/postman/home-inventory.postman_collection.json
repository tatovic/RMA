              { "key": "Authorization", "value": "Bearer {{tokenA}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{$randomUUID}}\",\n  \"name\": \"Predmet korisnika A\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"locationId\": \"{{locationIdA}}\",\n  \"quantity\": 1,\n  \"currency\": \"RSD\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/items", "host": ["{{baseUrl}}"], "path": ["items"] }
          }
        },
        {
          "name": "Korisnik B — traži predmet korisnika A (očekivano 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status je 404 — OWN-03, ne otkriva se postojanje tuđeg resursa', () => pm.response.to.have.status(404));",
                  "pm.test('error.code: NOT_FOUND', () => pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{tokenB}}" }],
            "url": {
              "raw": "{{baseUrl}}/items/{{itemIdA}}",
              "host": ["{{baseUrl}}"],
              "path": ["items", "{{itemIdA}}"]
            }
          }
        }
      ]
    }
  ]
}
